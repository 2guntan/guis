<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune donnée de l'app (producteurs, photos, session) ne part dans la sauvegarde Google
     ni dans le transfert vers un nouveau téléphone (Android 12 et plus). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
