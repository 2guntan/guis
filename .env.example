# Copier en .env sur le serveur (jamais dans git) et remplir.

# Mot de passe de la base PostgreSQL (long et aléatoire : openssl rand -hex 24)
POSTGRES_PASSWORD=

# Domaine servi en HTTPS par Caddy (ex. guis.exemple.sn, ou guis.<IP>.sslip.io). localhost en local.
GUIS_DOMAIN=localhost

# Mise à jour de l'app Android (numéros de build = numéro du run « apk » de la CI). Facultatif.
# En dessous de GUIS_MIN_APP_BUILD, l'app bloque et demande la mise à jour ; en dessous de
# GUIS_LATEST_APP_BUILD, elle affiche un bandeau. GUIS_APK_URL : lien de téléchargement de l'APK.
GUIS_MIN_APP_BUILD=
GUIS_LATEST_APP_BUILD=
GUIS_APK_URL=
